# 复制为 .env 后可以覆盖 docker-compose.yml 里的默认值。
# 注意：如果改数据库名，需要同时修改 initdb/*.sql 和 rAthenaZhCN 的 conf/import。

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ragnarok
MYSQL_USER=ragnarok
MYSQL_PASSWORD=ragnarok

# rAthena 服务端默认连 3306；被占用时改这里，并同步修改 conf/import/inter_conf.txt
DB_PORT=3306
# phpMyAdmin 端口
PMA_PORT=8080
TZ=Asia/Shanghai
